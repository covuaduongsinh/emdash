---
import { getEmDashEntry, decodeSlug } from "emdash";
import { PortableText } from "emdash/ui";
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import { getReadingTime } from "../../utils/reading-time";

const rawSlug = Astro.params.slug;
const slug = decodeSlug(rawSlug);

if (!slug) {
  return Astro.redirect("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
  return Astro.redirect("/404");
}

if (cacheHint) {
  Astro.cache?.set(cacheHint);
}

const title = post.data.title || "Bài viết";
const category = post.data.terms?.category?.[0]?.label || "Kiến thức cờ vua";
const readingTime = getReadingTime(post.data.content);
const publishDate = post.data.publishedAt
  ? new Date(post.data.publishedAt).toLocaleDateString("vi-VN", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    })
  : "";

const authorName = post.data.bylines?.[0]?.byline?.displayName || "HLV. Dương Sinh";
---

<Layout title={`${title} — Dương Sinh Chess Academy`}>
  <PageHero
    title={title}
    lead={`Chuyên mục: ${category} · Tác giả: ${authorName} ${publishDate ? `· Ngày đăng: ${publishDate}` : ''} · ${readingTime} phút đọc`}
    crumbCurrent="Chi tiết bài viết"
    badge={category.toUpperCase()}
  />

  <section class="sec alt">
    <div class="wrap">
      <div class="article-container">
        <!-- Nội dung chính -->
        <article class="article-content">
          {post.data.excerpt && (
            <p class="lead-paragraph">
              {post.data.excerpt}
            </p>
          )}

          <div class="prose-content">
            <PortableText value={post.data.content} />
          </div>

          <div class="article-author-card">
            <div class="author-avatar">
              <img src="/brand/pieces/wk.svg" alt="Tác giả" />
            </div>
            <div>
              <div class="author-role">TÁC GIẢ BÀI VIẾT</div>
              <div class="author-name">{authorName}</div>
              <p class="author-desc">
                Chủ nhiệm Học viện Cờ Vua Dương Sinh (DSC), người sáng lập chương trình đào tạo cờ vua 6 cấp độ chuẩn hóa.
              </p>
            </div>
          </div>
        </article>

        <!-- Sidebar form đăng ký -->
        <aside class="article-sidebar">
          <div class="sidebar-box">
            <h3>Đăng ký cho bé học thử</h3>
            <p>Kiểm tra trình độ và trải nghiệm buổi học cờ vua đầu tiên hoàn toàn miễn phí tại cơ sở DSC gần nhất.</p>
            <a href="/#tu-van" class="btn btn--primary" style="width: 100%; margin-top: 14px;">
              Đăng ký ngay
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<style>
  .article-container {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 48px;
  }

  .article-content {
    background: #fff;
    border-radius: var(--r-xl);
    padding: 44px;
    border: 1px solid var(--line);
    box-shadow: var(--sh-sm);
  }

  .lead-paragraph {
    font-size: 18.5px;
    line-height: 1.7;
    color: var(--navy);
    font-weight: 500;
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line-soft);
  }

  .prose-content {
    font-size: 16.5px;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .prose-content :global(h2) {
    font-size: 24px;
    font-weight: 900;
    color: var(--navy);
    margin: 32px 0 14px;
  }

  .prose-content :global(h3) {
    font-size: 20px;
    font-weight: 800;
    color: var(--navy);
    margin: 24px 0 12px;
  }

  .prose-content :global(p) {
    margin-bottom: 18px;
  }

  .prose-content :global(blockquote) {
    margin: 28px 0;
    padding: 24px 28px;
    background: var(--navy-soft);
    border-left: 4px solid var(--navy);
    border-radius: 0 var(--r-md) var(--r-md) 0;
    font-size: 17px;
    font-weight: 700;
    color: var(--navy);
    line-height: 1.6;
  }

  .prose-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--r-lg);
    margin: 20px 0;
  }

  .article-author-card {
    display: flex;
    gap: 20px;
    align-items: center;
    background: var(--bg);
    border-radius: var(--r-lg);
    padding: 24px;
    margin-top: 40px;
    border: 1px solid var(--line);
  }

  .author-avatar {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--navy), var(--navy-ink));
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .author-avatar img {
    width: 40px;
    height: 40px;
  }

  .author-role {
    font-family: var(--font-cond);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--teal-deep);
  }

  .author-name {
    font-size: 18px;
    font-weight: 900;
    color: var(--navy);
    margin: 2px 0 4px;
  }

  .author-desc {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--muted);
    margin: 0 !important;
  }

  /* Sidebar */
  .sidebar-box {
    position: sticky;
    top: 100px;
    background: #fff;
    border-radius: var(--r-xl);
    padding: 32px 24px;
    border: 1px solid var(--line);
    box-shadow: var(--sh-sm);
    text-align: center;
  }

  .sidebar-box h3 {
    font-size: 20px;
    font-weight: 900;
    color: var(--navy);
    margin-bottom: 10px;
  }

  .sidebar-box p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .article-container {
      grid-template-columns: 1fr;
    }
    .article-content {
      padding: 28px 20px;
    }
  }
</style>
