---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import { getReadingTime } from "../../utils/reading-time";

const { entries: emdashPosts, cacheHint } = await getEmDashCollection("posts", {
  orderBy: { published_at: "desc" },
});

if (cacheHint) {
  Astro.cache?.set(cacheHint);
}

// Batched query for categories/tags
const termsByEntry = await getTermsForEntries(
  "posts",
  emdashPosts.map((p) => p.data.id),
  "category"
);

function getImageUrl(img: unknown): string | undefined {
  if (!img || typeof img !== "object") return undefined;
  const image = img as Record<string, unknown>;
  if (typeof image.src === "string" && image.src) {
    return image.src;
  }
  const meta = image.meta as Record<string, unknown> | undefined;
  const storageKey =
    (typeof meta?.storageKey === "string" ? meta.storageKey : undefined) ||
    (typeof image.id === "string" ? image.id : undefined);
  if (storageKey) {
    return `/_emdash/api/media/file/${storageKey}`;
  }
  return undefined;
}

const formatDate = (d: Date | string | undefined) => {
  if (!d) return "";
  const dateObj = typeof d === "string" ? new Date(d) : d;
  return dateObj.toLocaleDateString("vi-VN", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  });
};

const pieceIcons = [
  "/brand/pieces/wn.svg",
  "/brand/pieces/wb.svg",
  "/brand/pieces/wk.svg",
  "/brand/pieces/wq.svg",
  "/brand/pieces/wr.svg",
  "/brand/pieces/wp.svg",
];

const posts = emdashPosts.map((p, idx) => {
  const cat = termsByEntry.get(p.data.id)?.[0]?.label || "Tin tức & Kiến thức";
  const readMins = getReadingTime(p.data.content);
  const featImg = getImageUrl(p.data.featured_image);
  return {
    slug: p.data.slug || p.id,
    title: p.data.title || "Bài viết",
    category: cat,
    date: formatDate(p.data.publishedAt || p.data.createdAt),
    readTime: `${readMins} phút đọc`,
    excerpt: p.data.excerpt || (typeof p.data.title === "string" ? p.data.title : ""),
    image: featImg,
    icon: pieceIcons[idx % pieceIcons.length],
  };
});

// Categories list for filter buttons
const categories = [...new Set(posts.map((p) => p.category).filter(Boolean))];
---

<Layout title="Tin tức & Học thuật Cờ Vua — dsc.edu.vn">
  <PageHero
    title="Góc Học Thuật & Tin Tức DSC"
    lead="Kho tàng kiến thức cờ vua, kinh nghiệm đồng hành cùng con và cập nhật các hoạt động, giải đấu mới nhất của Học viện Cờ Vua Dương Sinh."
    crumbCurrent="Tin tức"
    badge="TRI THỨC CỜ VUA"
  />

  <section class="sec alt reveal">
    <div class="wrap">
      {categories.length > 1 && (
        <div class="blog-filters">
          <button class="filter-btn active" data-cat="all">Tất cả bài viết ({posts.length})</button>
          {categories.map((cat) => (
            <button class="filter-btn" data-cat={cat}>{cat}</button>
          ))}
        </div>
      )}

      {posts.length === 0 ? (
        <div class="empty-state">
          <p>Chưa có bài viết nào được xuất bản.</p>
        </div>
      ) : (
        <div class="posts-grid">
          {posts.map((p) => (
            <article class="post-card" data-category={p.category}>
              <div class="post-thumb">
                {p.image ? (
                  <img src={p.image} alt={p.title} class="post-cover-img" />
                ) : (
                  <img src={p.icon} alt={p.title} class="post-icon" />
                )}
                <span class="post-cat-tag">{p.category}</span>
              </div>
              <div class="post-body">
                <div class="post-meta">
                  {p.date && <span>{p.date}</span>}
                  {p.date && <span class="meta-dot"></span>}
                  <span>{p.readTime}</span>
                </div>
                <h3 class="post-title">
                  <a href={`/blog/${p.slug}`}>{p.title}</a>
                </h3>
                {p.excerpt && <p class="post-excerpt">{p.excerpt}</p>}
                <div class="post-foot">
                  <a href={`/blog/${p.slug}`} class="read-more">
                    Đọc tiếp bài viết →
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.post-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const cat = btn.getAttribute('data-cat');

      cards.forEach((card) => {
        if (cat === 'all' || card.getAttribute('data-category') === cat) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  .blog-filters {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 48px;
  }

  .filter-btn {
    font-family: var(--font);
    font-size: 14px;
    font-weight: 600;
    padding: 8px 18px;
    border-radius: var(--r-pill);
    border: 1.5px solid var(--line);
    background: #fff;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--dur);
  }

  .filter-btn:hover {
    border-color: var(--navy);
    color: var(--navy);
  }

  .filter-btn.active {
    background: var(--navy);
    border-color: var(--navy);
    color: #fff;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  .post-card {
    background: #fff;
    border-radius: var(--r-xl);
    border: 1px solid var(--line);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--sh-sm);
    transition: all var(--dur) var(--ease);
  }

  .post-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--sh-hover);
    border-color: var(--teal);
  }

  .post-thumb {
    position: relative;
    height: 180px;
    background: linear-gradient(135deg, var(--navy) 0%, var(--navy-ink) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .post-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-icon {
    width: 80px;
    height: 80px;
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.25));
    transition: transform var(--dur) var(--ease);
  }

  .post-card:hover .post-icon {
    transform: scale(1.1) rotate(5deg);
  }

  .post-cat-tag {
    position: absolute;
    bottom: 12px;
    left: 14px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(4px);
    color: var(--navy);
    font-family: var(--font-cond);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 10px;
    border-radius: var(--r-pill);
  }

  .post-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 10px;
    font-weight: 500;
  }

  .meta-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--line-soft);
  }

  .post-title {
    font-size: 18px;
    font-weight: 800;
    line-height: 1.45;
    margin-bottom: 10px;
  }

  .post-title a {
    color: var(--navy);
    text-decoration: none;
    transition: color var(--dur);
  }

  .post-title a:hover {
    color: var(--teal);
  }

  .post-excerpt {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 20px;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-foot {
    border-top: 1px solid var(--line-soft);
    padding-top: 14px;
    margin-top: auto;
  }

  .read-more {
    font-size: 14px;
    font-weight: 700;
    color: var(--teal-deep);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: gap var(--dur);
  }

  .read-more:hover {
    gap: 8px;
    color: var(--navy);
  }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
    font-size: 16px;
    color: var(--text-muted);
  }

  @media (max-width: 960px) {
    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
