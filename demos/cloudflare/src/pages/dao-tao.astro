---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ConsultForm from '../components/ConsultForm.astro';

const levels = [
  {
    step: '1/6',
    piece: 'Tốt',
    tag: 'Nhập môn',
    icon: '/brand/pieces/wp.svg',
    title: 'Cấp độ 1 — Tốt (Vỡ lòng & Luật chơi)',
    desc: 'Làm quen với bàn cờ, cách di chuyển và bắt quân của 6 loại quân cờ. Học các quy tắc chiếu, chiếu hết, phong cấp và nhập thành.',
    outcomes: ['Hiểu rõ luật cờ vua FIDE', 'Biết cách ghi biên bản ván đấu', 'Hình thành phản xạ tập trung 45-60 phút'],
    bg: 'var(--navy)',
  },
  {
    step: '2/6',
    piece: 'Mã',
    tag: 'Cơ bản 1',
    icon: '/brand/pieces/wn.svg',
    title: 'Cấp độ 2 — Mã (Tư duy không gian & Đòn đôi)',
    desc: 'Khám phá sự biến hóa của quân Mã, nhận diện đòn bắt đôi hiểm hóc. Làm quen với các khái niệm an toàn vua và trung tâm bàn cờ.',
    outcomes: ['Thành thạo đòn tấn công đôi', 'Khai cuộc theo nguyên lý chuẩn', 'Tính toán trước 2–3 nước đi'],
    bg: 'var(--navy-soft)',
  },
  {
    step: '3/6',
    piece: 'Tượng',
    tag: 'Cơ bản 2',
    icon: '/brand/pieces/wb.svg',
    title: 'Cấp độ 3 — Tượng (Kiểm soát đường chéo & Giằng)',
    desc: 'Nắm vững sức mạnh cặp Tượng, khai thác đòn giằng và đòn xiên. Học cách phối hợp Tượng – Mã để làm chủ thế trận.',
    outcomes: ['Thực hiện đòn giằng và mở đường', 'Chiến thuật phối hợp đa quân', 'Giải được bài tập thế cờ 2 nước'],
    bg: 'var(--navy-soft)',
  },
  {
    step: '4/6',
    piece: 'Xe',
    tag: 'Cơ bản 3',
    icon: '/brand/pieces/wr.svg',
    title: 'Cấp độ 4 — Xe (Cột mở & Chiến lược tàn cuộc)',
    desc: 'Kiểm soát hàng ngang số 7 và cột mở. Nắm vững kỹ thuật tàn cuộc cơ bản với Xe và Tốt, nguyên tắc hình học bàn cờ.',
    outcomes: ['Khai thác cột mở tối đa', 'Thành thạo tàn cuộc Xe cơ bản', 'Tư duy lập kế hoạch trung cuộc'],
    bg: 'var(--navy-soft)',
  },
  {
    step: '5/6',
    piece: 'Hậu',
    tag: 'Nâng cao 1',
    icon: '/brand/pieces/wq.svg',
    title: 'Cấp độ 5 — Hậu (Phối hợp toàn năng)',
    desc: 'Phát huy sức mạnh áp đảo của quân Hậu. Học các hệ thống khai cuộc chuyên sâu, chiến thuật tấn công cánh Vua và phản công.',
    outcomes: ['Xây dựng kho khai cuộc riêng', 'Phân tích điểm yếu đối phương', 'Thi đấu giải cấp trường / quận'],
    bg: 'var(--navy-soft)',
  },
  {
    step: '6/6',
    piece: 'Vua',
    tag: 'Nâng cao 2',
    icon: '/brand/pieces/wk.svg',
    title: 'Cấp độ 6 — Vua (Bản lĩnh thủ lĩnh & Giải đấu)',
    desc: 'Tư duy chiến lược cao cấp, tâm lý thi đấu đỉnh cao. Rèn luyện sự điềm tĩnh, tính toán sâu 5–7 nước và xử lý áp lực thời gian.',
    outcomes: ['Đạt chuẩn Elo FIDE 1200–1600', 'Sẵn sàng giải Thành phố & Quốc gia', 'Tư duy lãnh đạo và ra quyết định'],
    bg: 'var(--teal-soft)',
  },
];
---

<Layout title="Chương trình Đào tạo Cờ Vua 6 Cấp Độ — dsc.edu.vn">
  <PageHero
    title="Chương trình Đào tạo Cờ Vua Chuẩn Hóa"
    lead="Lộ trình 6 cấp độ độc quyền của Học viện Cờ Vua Dương Sinh giúp trẻ phát triển toàn diện tư duy logic, phản xạ chiến thuật và bản lĩnh thi đấu."
    crumbCurrent="Chương trình đào tạo"
    badge="HỆ THỐNG GIÁO TRÌNH ĐỘC QUYỀN"
    chips={['Sĩ số 8–10 học viên', 'Giáo trình trực quan', 'Đánh giá năng lực định kỳ', '100% HLV FIDE']}
  />

  <!-- 1. Lộ trình 6 cấp -->
  <section class="sec alt reveal">
    <div class="wrap">
      <div class="shead">
        <div class="overline overline--teal">CHUẨN HÓA NĂNG LỰC</div>
        <h2>Hệ thống 6 Cấp Độ Đào Tạo (Tốt ➔ Vua)</h2>
        <p>Mỗi cấp độ đều có chuẩn đầu ra rõ ràng về kiến thức, kỹ thuật và kỹ năng tư duy.</p>
      </div>

      <div class="level-grid">
        {levels.map((lvl) => (
          <div class="level-card">
            <div class="level-head">
              <div class="level-icon-box" style={`background: ${lvl.bg};`}>
                <img src={lvl.icon} alt={lvl.piece} class="level-icon" style={lvl.piece === 'Tốt' ? 'filter: brightness(0) invert(1);' : ''} />
              </div>
              <div>
                <span class="level-step">{lvl.step} · {lvl.tag}</span>
                <h3 class="level-title">{lvl.title}</h3>
              </div>
            </div>

            <p class="level-desc">{lvl.desc}</p>

            <div class="level-outcomes">
              <div class="outcome-label">Chuẩn đầu ra:</div>
              <ul>
                {lvl.outcomes.map((item) => (
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 2. Phân nhóm theo độ tuổi -->
  <section class="sec reveal">
    <div class="wrap">
      <div class="shead">
        <div class="overline">PHƯƠNG PHÁP THEO LỨA TUỔI</div>
        <h2>Phương pháp giảng dạy phù hợp tâm lý</h2>
        <p>Tối ưu hóa khả năng tiếp thu và cảm hứng học tập của từng độ tuổi</p>
      </div>

      <div class="age-grid">
        <div class="age-card">
          <div class="age-head">
            <div class="age-icon-wrap">
              <img src="/brand/pieces/wn.svg" alt="Mầm non" />
            </div>
            <div>
              <span class="age-badge">4 – 6 TUỔI</span>
              <h3>Lớp Cờ vua Mầm non — Học qua Kể chuyện</h3>
            </div>
          </div>
          <p>
            Trẻ mầm non tiếp thu thế giới qua hình ảnh và cảm xúc. DSC áp dụng phương pháp nhân cách hóa quân cờ thành những người bạn ngộ nghĩnh, giúp trẻ làm quen với luật cờ một cách tự nhiên, rèn luyện tính kiên nhẫn và ngồi yên tập trung.
          </p>
        </div>

        <div class="age-card">
          <div class="age-head">
            <div class="age-icon-wrap">
              <img src="/brand/pieces/wq.svg" alt="Học sinh" />
            </div>
            <div>
              <span class="age-badge">6 – 14 TUỔI</span>
              <h3>Lớp Cờ vua Học sinh — Tư duy Chiến thuật</h3>
            </div>
          </div>
          <p>
            Tập trung phát triển tư duy phản biện, khả năng phân tích đa chiều và tính toán nước cờ sâu. Học sinh được rèn luyện tác phong thi đấu chuyên nghiệp, tính kỷ luật và bản lĩnh đối mặt với thành công cũng như thất bại.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Bảng học phí & quyền lợi -->
  <section class="sec alt reveal">
    <div class="wrap">
      <div class="shead">
        <div class="overline overline--teal">HỌC PHÍ MINH BẠCH</div>
        <h2>Các gói đào tạo & Quyền lợi học viên</h2>
        <p>Cam kết chất lượng đào tạo và sự tiến bộ rõ rệt sau mỗi khóa học</p>
      </div>

      <div class="pricing-grid">
        <!-- Gói 1: Học thử -->
        <div class="pricing-card">
          <div class="plan-name">BUỔI HỌC THỬ</div>
          <div class="plan-price">0đ <small>/ buổi đầu tiên</small></div>
          <p class="plan-desc">Trải nghiệm không gian học tập và kiểm tra trình độ cùng HLV.</p>
          <ul class="plan-features">
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> 90 phút học trực tiếp</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Đánh giá chỉ số tư duy</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Tư vấn lộ trình 1-1 cho phụ huynh</li>
          </ul>
          <a href="#tu-van" class="btn btn--ghost" style="width: 100%;">Đăng ký học thử</a>
        </div>

        <!-- Gói 2: Tiêu chuẩn (Phổ biến) -->
        <div class="pricing-card featured">
          <div class="featured-tag">Phổ biến nhất</div>
          <div class="plan-name">KHÓA TIÊU CHUẨN</div>
          <div class="plan-price">750.000đ <small>/ tháng</small></div>
          <p class="plan-desc">Khóa học nền tảng toàn diện giúp bé tiến bộ nhanh và yêu thích cờ vua.</p>
          <ul class="plan-features">
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> 8 buổi học (90 phút/buổi)</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Sĩ số tối đa 8–10 học viên</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Giáo trình in màu độc quyền DSC</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Tham gia giải đấu giao hữu nội bộ</li>
          </ul>
          <a href="#tu-van" class="btn btn--primary" style="width: 100%;">Đăng ký nhập học</a>
        </div>

        <!-- Gói 3: Chuyên sâu -->
        <div class="pricing-card">
          <div class="plan-name">KHÓA CHUYÊN SÂU</div>
          <div class="plan-price">1.050.000đ <small>/ tháng</small></div>
          <p class="plan-desc">Dành cho học viên định hướng thi đấu và nâng cao đẳng cấp Elo.</p>
          <ul class="plan-features">
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> 8 buổi học chuyên sâu (120 phút)</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Sĩ số nhóm nhỏ 4–6 học viên</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Huấn luyện trực tiếp cùng Đại kiện tướng</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Luyện thi giải Thành phố & Quốc gia</li>
          </ul>
          <a href="#tu-van" class="btn btn--ghost" style="width: 100%;">Tư vấn chuyên sâu</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Form thu lead -->
  <section class="sec reveal" style="padding-top: 30px;">
    <div class="wrap">
      <ConsultForm id="tu-van" />
    </div>
  </section>
</Layout>

<style>
  /* Levels */
  .level-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }

  .level-card {
    background: #fff;
    border-radius: var(--r-xl);
    padding: 32px;
    border: 1px solid var(--line);
    box-shadow: var(--sh-sm);
    transition: transform var(--dur);
  }

  .level-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--sh-md);
  }

  .level-head {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }

  .level-icon-box {
    width: 60px;
    height: 60px;
    border-radius: var(--r-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .level-icon {
    width: 38px;
    height: 38px;
  }

  .level-step {
    font-family: var(--font-cond);
    font-size: 13px;
    font-weight: 700;
    color: var(--teal-deep);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .level-title {
    font-size: 19px;
    font-weight: 900;
    color: var(--navy);
    margin-top: 2px;
  }

  .level-desc {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  .level-outcomes {
    background: var(--bg);
    border-radius: var(--r-md);
    padding: 16px 20px;
  }

  .outcome-label {
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 8px;
  }

  .level-outcomes ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .level-outcomes li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13.5px;
    color: var(--text-secondary);
  }

  .level-outcomes svg {
    width: 15px;
    height: 15px;
    color: var(--teal);
    flex-shrink: 0;
  }

  /* Age cards */
  .age-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }

  .age-card {
    background: #fff;
    border-radius: var(--r-xl);
    padding: 36px;
    border: 1px solid var(--line);
    box-shadow: var(--sh-sm);
  }

  .age-head {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }

  .age-icon-wrap {
    width: 60px;
    height: 60px;
    border-radius: var(--r-lg);
    background: var(--navy-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .age-icon-wrap img {
    width: 36px;
    height: 36px;
  }

  .age-badge {
    display: inline-block;
    background: var(--teal-soft);
    color: var(--teal-deep);
    font-family: var(--font-cond);
    font-size: 12px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: var(--r-pill);
    margin-bottom: 4px;
  }

  .age-head h3 {
    font-size: 20px;
    font-weight: 900;
    color: var(--navy);
  }

  .age-card p {
    font-size: 15px;
    line-height: 1.65;
    color: var(--muted);
  }

  /* Pricing */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .pricing-card {
    background: #fff;
    border-radius: var(--r-2xl);
    padding: 36px 30px;
    border: 1px solid var(--line);
    box-shadow: var(--sh-sm);
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform var(--dur);
  }

  .pricing-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--sh-md);
  }

  .pricing-card.featured {
    border: 2px solid var(--navy);
    box-shadow: var(--sh-lg);
  }

  .featured-tag {
    position: absolute;
    top: -13px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--teal);
    color: #fff;
    font-size: 12.5px;
    font-weight: 700;
    padding: 4px 14px;
    border-radius: var(--r-pill);
  }

  .plan-name {
    font-family: var(--font-cond);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--navy);
    text-transform: uppercase;
  }

  .plan-price {
    font-family: var(--font-cond);
    font-size: 38px;
    font-weight: 900;
    color: var(--navy);
    margin: 12px 0 8px;
  }

  .plan-price small {
    font-family: var(--font);
    font-size: 14px;
    font-weight: 400;
    color: var(--muted);
  }

  .plan-desc {
    font-size: 14px;
    line-height: 1.55;
    color: var(--muted);
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line-soft);
  }

  .plan-features {
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex-grow: 1;
  }

  .plan-features li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--text-secondary);
  }

  .plan-features svg {
    width: 17px;
    height: 17px;
    color: var(--teal);
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .level-grid, .age-grid, .pricing-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
