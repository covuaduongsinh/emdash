---
import { getEmDashCollection } from "emdash";
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import { PuzzleOfTheDay } from "@duongsinh/plugin-chess-puzzles/astro";
import { SAMPLE_SIX_LEVEL_PUZZLES } from "@duongsinh/plugin-chess-puzzles";
import { LEVEL_LIST } from "@duongsinh/chess-kit/core";

const currentLevel = Astro.url.searchParams.get("level") || "";
const currentTheme = Astro.url.searchParams.get("theme") || "";

// Lấy danh sách câu đố đã xuất bản từ CSDL
let allPuzzles: Array<Record<string, any>> = [];
let dailyPuzzle: any = null;

try {
  const result = await getEmDashCollection("chess_puzzles", {
    orderBy: { created_at: "desc" },
    limit: 100,
  });

  if (result?.cacheHint) {
    Astro.cache?.set(result.cacheHint);
  }

  const rawPuzzles = (result?.entries || []).map((e: any) => ({
    id: e.data?.id || e.id,
    slug: e.data?.slug || e.slug,
    title: e.data?.title || "Câu đố cờ vua",
    level: e.data?.level,
    rating: e.data?.rating,
    prompt: e.data?.prompt,
    themes: e.data?.themes,
    puzzle: typeof e.data?.puzzle === "string" ? JSON.parse(e.data.puzzle) : e.data?.puzzle,
    hint: e.data?.hint,
    explanation: e.data?.explanation,
    source: e.data?.source,
  }));

  if (rawPuzzles.length > 0) {
    allPuzzles = rawPuzzles;
  } else {
    allPuzzles = SAMPLE_SIX_LEVEL_PUZZLES.map((p, idx) => ({
      id: `sample-puzzle-${idx + 1}`,
      slug: p.slug,
      title: p.title,
      level: p.level,
      rating: p.rating,
      prompt: p.prompt,
      themes: p.themes,
      puzzle: p.puzzle,
      hint: p.hint,
      explanation: p.explanation,
      source: p.source,
    }));
  }
} catch {
  allPuzzles = SAMPLE_SIX_LEVEL_PUZZLES.map((p, idx) => ({
    id: `sample-puzzle-${idx + 1}`,
    slug: p.slug,
    title: p.title,
    level: p.level,
    rating: p.rating,
    prompt: p.prompt,
    themes: p.themes,
    puzzle: p.puzzle,
    hint: p.hint,
    explanation: p.explanation,
    source: p.source,
  }));
}

if (allPuzzles.length > 0) {
  dailyPuzzle = allPuzzles[0];
}

const puzzles = allPuzzles.filter((p) => {
  if (currentLevel && p.level !== currentLevel) return false;
  if (currentTheme && !p.themes?.toLowerCase().includes(currentTheme.toLowerCase())) return false;
  return true;
});

const levelCounts = LEVEL_LIST.map((lvl) => ({
  ...lvl,
  count: allPuzzles.filter((p) => p.level === lvl.id).length,
  isActive: currentLevel === lvl.id,
}));
---

<Layout
  title="Kho Câu Đố Chiến Thuật Cờ Vua — Cờ Vua Học Đường"
  description="Luyện tập chiến thuật cờ vua hàng ngày theo lộ trình chuẩn 6 cấp độ từ cơ bản đến chuyên sâu."
>
  <PageHero
    title="Kho Câu Đố Chiến Thuật"
    lead="Rèn luyện tư duy quan sát, đòn phối hợp chiến thuật và kỹ năng tính toán biến thông qua ngân hàng thế cờ tương tác."
    crumbCurrent="Câu đố chiến thuật"
    badge="LUYỆN TẬP TƯ DUY"
  />

  <section class="sec">
    <div class="wrap">
      {dailyPuzzle && (
        <div class="mb-12">
          <div class="max-w-xl mx-auto">
            <PuzzleOfTheDay puzzle={dailyPuzzle} title="Câu Đố Nổi Bật Trong Ngày" />
          </div>
        </div>
      )}

      <!-- Phân loại theo 6 cấp độ cờ Dương Sinh -->
      <div class="mb-8">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-bold text-gray-900 flex items-center gap-2">
            <span>🎯</span> Phân loại theo cấp độ
          </h2>
          {currentLevel && (
            <a href="/cau-do" class="text-xs text-blue-600 font-semibold hover:underline">
              Xóa bộ lọc (Xem tất cả)
            </a>
          )}
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">
          {levelCounts.map((lvl) => (
            <a
              href={lvl.isActive ? "/cau-do" : `/cau-do?level=${lvl.id}`}
              class={`rounded-xl border p-3 text-center transition-all ${
                lvl.isActive
                  ? "border-blue-500 bg-blue-50/50 ring-2 ring-blue-500/20 shadow-sm"
                  : "border-gray-200 bg-white hover:border-blue-300 shadow-xs"
              }`}
            >
              <span
                class="inline-block w-3 h-3 rounded-full mb-1"
                style={`background-color: ${lvl.color}`}
              ></span>
              <div class="font-bold text-xs text-gray-900">{lvl.nameVi}</div>
              <div class="text-[10px] text-gray-500 mt-0.5">{lvl.elo} Elo</div>
              <div class="text-[11px] font-semibold text-blue-600 mt-1">{lvl.count} câu</div>
            </a>
          ))}
        </div>
      </div>

      <!-- Danh sách câu đố theo lưới -->
      <div class="mb-6 flex items-center justify-between">
        <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2">
          <span>🧩</span> Danh sách bài tập ({puzzles.length})
        </h2>
        {currentTheme && (
          <div class="flex items-center gap-2 text-xs text-gray-600">
            <span>Chủ đề: <strong class="text-blue-600">{currentTheme}</strong></span>
            <a href="/cau-do" class="text-red-500 hover:underline">✕</a>
          </div>
        )}
      </div>

      {puzzles.length === 0 ? (
        <div class="rounded-2xl border border-dashed border-gray-300 bg-gray-50 p-12 text-center">
          <span class="text-4xl">♟️</span>
          <h3 class="text-lg font-bold text-gray-900 mt-3">Chưa có câu đố nào phù hợp</h3>
          <p class="text-sm text-gray-500 mt-1 max-w-md mx-auto">
            Hãy thử chọn cấp độ hoặc chủ đề khác, hoặc quay lại xem toàn bộ ngân hàng câu đố.
          </p>
          <a
            href="/cau-do"
            class="mt-4 inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-xs hover:bg-blue-700"
          >
            Xem tất cả câu đố
          </a>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {puzzles.map((p) => {
            const levelObj = LEVEL_LIST.find((lvl) => lvl.id === p.level);
            return (
              <a
                href={`/cau-do/${p.slug || p.id}`}
                class="group flex flex-col justify-between rounded-2xl border border-gray-200 bg-white p-5 shadow-xs transition-all hover:-translate-y-0.5 hover:shadow-md hover:border-blue-400"
              >
                <div>
                  <div class="flex items-center justify-between gap-2 mb-2">
                    {levelObj ? (
                      <span
                        class="rounded-md px-2 py-0.5 text-xs font-bold text-white uppercase"
                        style={`background-color: ${levelObj.color}`}
                      >
                        {levelObj.nameVi}
                      </span>
                    ) : (
                      <span class="rounded-md bg-gray-100 px-2 py-0.5 text-xs font-semibold text-gray-600">
                        {p.level || "Tất cả"}
                      </span>
                    )}
                    {p.rating && (
                      <span class="text-xs font-semibold text-amber-600 bg-amber-50 px-2 py-0.5 rounded">
                        ★ {p.rating}
                      </span>
                    )}
                  </div>

                  <h3 class="text-base font-bold text-gray-900 group-hover:text-blue-600 transition-colors line-clamp-1">
                    {p.title}
                  </h3>

                  {p.prompt && (
                    <p class="text-xs text-gray-600 mt-1.5 line-clamp-2">
                      {p.prompt}
                    </p>
                  )}
                </div>

                <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-xs">
                  <span class="text-gray-500 font-medium truncate max-w-[180px]">
                    {p.themes ? p.themes.split(",").slice(0, 2).join(", ") : "Chiến thuật cờ"}
                  </span>
                  <span class="font-bold text-blue-600 group-hover:translate-x-0.5 transition-transform">
                    Giải câu đố &rarr;
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      )}
    </div>
  </section>
</Layout>
