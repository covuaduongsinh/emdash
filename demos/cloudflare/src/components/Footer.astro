      </div>
    </div>

    <div class="ftr-bot">
      <div>© {new Date().getFullYear()} Cờ Vua Học Đường Việt Nam (covuahocduong.com). Bảo lưu mọi quyền.</div>
      <div>Ươm mầm tư duy — Nâng tầm trí tuệ học sinh Việt Nam</div>
    </div>
  </div>
</footer>

<style>
  .ftr {
    background: var(--navy-ink);
    color: rgba(255, 255, 255, 0.72);
    padding: 64px 0 28px;
    position: relative;
    overflow: hidden;
  }

  .ftr-pat {
    position: absolute;
    inset: 0;
    background-image: url('/brand/pattern-tile-white.svg');
    background-size: 72px;
    opacity: 0.04;
    pointer-events: none;
  }

  .ftr-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    gap: 40px;
    padding-bottom: 38px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .flogo {
    height: 44px;
    margin-bottom: 16px;
  }

  .ftr p {
    font-size: 14.5px;
    line-height: 1.7;
    margin: 0;
  }

  .ftr h4 {
    color: #fff;
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 16px;
    font-family: var(--font-cond);
  }

  .ftr ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ftr ul a {
    font-size: 14px;
    transition: color var(--dur);
  }

  .ftr ul a:hover {
    color: var(--teal);
  }

  .crow {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 14px;
    margin-bottom: 12px;
  }

  .crow svg {
    width: 17px;
    height: 17px;
    color: var(--teal);
    flex-shrink: 0;
    margin-top: 3px;
  }

  .ftr-bot {
    position: relative;
    padding-top: 22px;
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.5);
    flex-wrap: wrap;
    gap: 8px;
  }

  @media (max-width: 860px) {
    .ftr-grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 520px) {
    .ftr-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
