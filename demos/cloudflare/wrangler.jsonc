{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "covuahocduong",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-01-14",
	// disable_nodejs_process_v2 needed until unenv fix lands in Pages
	// See: https://github.com/withastro/astro/issues/14511
	"compatibility_flags": ["nodejs_compat", "disable_nodejs_process_v2"],
	"routes": [
		{
			"pattern": "covuahocduong.com",
			"custom_domain": true
		},
		{
			"pattern": "www.covuahocduong.com",
			"custom_domain": true
		}
	],
	// Native Workers Caching (edge HTML in front of the Worker). No zone ID or
	// Cache Purge API token. Pair with cacheCloudflare() in astro.config.mjs.
	// Purge from the Worker with cache.purge() from cloudflare:workers.
	"cache": {
		"enabled": true,
	},
	"workers_dev": true,
	// D1 Database binding
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "emdash_db",
			"database_id": "ae446e38-3446-403a-a827-4e60f90fe9e7"
		}
	],
	// R2 bucket for media storage
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "emdash-media",
		},
	],
	// Cron triggers drive general maintenance.
	"triggers": {
		"crons": ["* * * * *"],
	},
	// Observability
	"observability": {
		"enabled": true,
	},
	"ai_search_namespaces": [
		{
			"binding": "AI_SEARCH",
			"namespace": "default",
		},
	],
}
