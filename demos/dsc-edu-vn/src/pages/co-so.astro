---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ConsultForm from '../components/ConsultForm.astro';

const regions = [
  {
    region: 'Khu vực Miền Bắc',
    tag: 'BẮC BỘ — HƠN 320 CLB THÀNH VIÊN',
    desc: 'Mạng lưới câu lạc bộ cờ vua tại các trường Tiểu học, THCS và THPT trọng điểm tại Hà Nội, Hải Phòng, Quảng Ninh, Bắc Ninh, Vĩnh Phúc, Thái Nguyên, Ninh Bình...',
    highlights: [
      'Sinh hoạt định kỳ theo tuần tại phòng sinh hoạt CLB trường',
      'Được trang bị bộ cờ tiêu chuẩn FIDE & bàn cờ treo tường',
      'Tổ chức sinh hoạt chuyên đề & ngày hội trí tuệ cấp trường',
      'Có sự bảo trợ chuyên môn từ Hội đồng Sư phạm Cờ Vua Học Đường',
    ],
    contactPerson: 'Thường trực Ban Điều phối Miền Bắc: 0983.119.819',
  },
  {
    region: 'Khu vực Miền Trung & Tây Nguyên',
    tag: 'TRUNG BỘ & TÂY NGUYÊN — HƠN 180 CLB THÀNH VIÊN',
    desc: 'Hệ thống kết nối phong trào cờ vua trường học tại Đà Nẵng, Thừa Thiên Huế, Nghệ An, Hà Tĩnh, Quảng Nam, Khánh Hòa, Đắk Lắk, Lâm Đồng...',
    highlights: [
      'Giao lưu trực tuyến định kỳ giữa các CLB cờ vua học sinh',
      'Tập huấn giáo viên Thể dục và Tổng phụ trách Đội',
      'Cung cấp giáo trình điện tử và kho bài tập chiến thuật',
      'Tổ chức Ngày hội Cờ vua Học đường Mùa hè thường niên',
    ],
    contactPerson: 'Thường trực Ban Điều phối Miền Trung: 0983.119.819',
  },
  {
    region: 'Khu vực Miền Nam',
    tag: 'NAM BỘ — HƠN 350 CLB THÀNH VIÊN',
    desc: 'Cộng đồng cờ vua học đường năng động tại TP. Hồ Chí Minh, Bình Dương, Đồng Nai, Bà Rịa - Vũng Tàu, Long An, Cần Thơ, Tiền Giang...',
    highlights: [
      'Mô hình CLB bán trú & ngoại khóa tự quản hiệu quả',
      'Giao lưu học tập & phân tích ván đấu liên trường',
      'Ứng dụng công nghệ đấu trường học tập trực tuyến',
      'Định hướng bồi dưỡng tư duy và phát triển năng khiếu học sinh',
    ],
    contactPerson: 'Thường trực Ban Điều phối Miền Nam: 0983.119.819',
  },
];

const setupSteps = [
  {
    step: '01',
    title: 'Khảo sát nhu cầu & Ra mắt CLB',
    desc: 'Khảo sát số lượng học sinh đam mê cờ vua tại trường, chỉ định Giáo viên Phụ trách (Tổng phụ trách/Giáo viên Thể dục) và Ban Chủ nhiệm học sinh.',
  },
  {
    step: '02',
    title: 'Trang bị cơ sở vật chất chuẩn',
    desc: 'Bố trí phòng chức năng hoặc góc cờ vua sân trường, trang bị bàn cờ nhựa dẻo FIDE, đồng hồ bấm giờ và bàn cờ biểu diễn treo tường.',
  },
  {
    step: '03',
    title: 'Tiếp nhận khung giáo án 36 tuần',
    desc: 'Cờ Vua Học Đường chuyển giao bộ giáo án sinh hoạt CLB 36 tuần theo chủ đề: Khai cuộc thông minh, Đòn phối hợp, Tàn cuộc căn bản & Kỹ năng tư duy logic.',
  },
  {
    step: '04',
    title: 'Tập huấn nghiệp vụ hướng dẫn viên',
    desc: 'Được tham gia các khóa tập huấn phương pháp sư phạm cờ vua, kỹ năng hướng dẫn học sinh và quản lý CLB do chuyên gia trực tiếp hướng dẫn.',
  },
  {
    step: '05',
    title: 'Sinh hoạt chuyên đề & Ngày hội Cờ vua',
    desc: 'Định kỳ tổ chức ngày hội cờ vua trường học, sinh hoạt chuyên đề giải thế cờ và giao lưu rèn luyện tác phong văn hóa học đường.',
  },
];
---

<Layout title="Mạng Lưới Câu Lạc Bộ Cờ Vua Trường Học Toàn Quốc">
  <PageHero
    title="Mạng Lưới CLB Cờ Vua Trường Học"
    lead="Đồng hành cùng hơn 850+ trường học trên toàn quốc xây dựng, vận hành và phát triển câu lạc bộ cờ vua học đường bài bản, bền vững và đầy cảm hứng."
    crumbCurrent="CLB Trường học"
    badge="KẾT NỐI 63 TỈNH THÀNH"
    chips={['Hơn 850+ CLB Thành viên', 'Giáo án sinh hoạt 36 tuần', 'Tập huấn giáo viên miễn phí', 'Học liệu tương tác FEN/PGN']}
  />

  <!-- Mạng lưới khu vực -->
  <section class="sec alt reveal">
    <div class="wrap">
      <div class="shead">
        <div class="overline overline--teal">MẠNG LƯỚI TOÀN QUỐC</div>
        <h2>Hệ thống CLB Cờ vua Trường học theo Khu vực</h2>
        <p>Kết nối các trường phổ thông trên khắp cả nước trong một hệ sinh thái học tập và rèn luyện tư duy cờ vua chuẩn mực</p>
      </div>

      <div class="regions-list">
        {regions.map((r, index) => (
          <div class={`region-card ${index % 2 === 1 ? 'reverse' : ''}`}>
            <div class="region-info">
              <span class="r-tag">{r.tag}</span>
              <h3>{r.region}</h3>
              <p class="region-desc">{r.desc}</p>

              <div class="r-highlights">
                <div class="hl-title">Đặc điểm sinh hoạt & Hỗ trợ:</div>
                <ul class="hl-list">
                  {r.highlights.map((h) => (
                    <li>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="r-contact">
                <strong>{r.contactPerson}</strong>
              </div>

              <div class="r-actions">
                <a href="#tu-van" class="btn btn--primary btn--sm">Đăng ký CLB gia nhập mạng lưới</a>
              </div>
            </div>

            <div class="region-visual">
              <div class="visual-box">
                <div class="visual-icon">🏛️</div>
                <div class="visual-title">{r.region}</div>
                <div class="visual-stat">CLB Cờ Vua Học Đường</div>
                <p>Cung cấp đầy đủ học liệu, bàn cờ mẫu, giáo án sinh hoạt và hỗ trợ trọng tài cho các trường thành viên.</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5 bước thành lập CLB cờ vua tại trường học -->
  <section class="sec reveal">
    <div class="wrap">
      <div class="shead">
        <div class="overline overline--teal">HƯỚNG DẪN DÀNH CHO NHÀ TRƯỜNG</div>
        <h2>5 Bước Thành Lập & Vận Hành CLB Cờ Vua Trường Học</h2>
        <p>Quy trình chuẩn hóa giúp thầy cô và nhà trường triển khai câu lạc bộ cờ vua nhanh chóng, tiết kiệm và hiệu quả</p>
      </div>

      <div class="steps-grid">
        {setupSteps.map((s) => (
          <div class="step-card">
            <div class="step-number">{s.step}</div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Box đồng hành cùng nhà trường -->
  <section class="sec reveal" style="padding-top: 10px;">
    <div class="wrap">
      <div class="setup-cta">
        <div class="setup-cta-in">
          <h2>Nhà trường muốn thành lập CLB Cờ Vua hoặc nâng cấp phong trào?</h2>
          <p>Cờ Vua Học Đường hỗ trợ toàn diện từ khung điều lệ mẫu, giáo án sinh hoạt 36 tuần đến trang thiết bị dụng cụ và tập huấn giáo viên phụ trách.</p>
          <a href="#tu-van" class="btn btn--onnavy btn--lg">
            Đăng ký nhận gói hỗ trợ CLB Trường học →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Form đăng ký -->
  <section class="sec reveal">
    <div class="wrap">
      <ConsultForm id="tu-van" />
    </div>
  </section>
</Layout>

<style>
  .regions-list {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .region-card {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 36px;
    background: #fff;
    border-radius: var(--r-2xl);
    padding: 40px;
    border: 1px solid var(--line);
    box-shadow: var(--sh-sm);
    align-items: center;
  }

  .region-card.reverse {
    grid-template-columns: 0.8fr 1.2fr;
  }

  .region-card.reverse .region-info {
    order: 2;
  }

  .region-card.reverse .region-visual {
    order: 1;
  }

  .r-tag {
    display: inline-block;
    background: var(--navy-soft);
    color: var(--navy);
    font-family: var(--font-cond);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 4px 12px;
    border-radius: var(--r-pill);
    margin-bottom: 12px;
  }

  .region-info h3 {
    font-size: 26px;
    font-weight: 900;
    color: var(--navy);
    margin-bottom: 12px;
  }

  .region-desc {
    font-size: 15px;
    color: var(--ink-light);
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .r-highlights {
    background: var(--bg);
    border-radius: var(--r-lg);
    padding: 20px;
    margin-bottom: 20px;
  }

  .hl-title {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 12px;
  }

  .hl-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }

  .hl-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 14px;
    color: var(--text-secondary);
  }

  .hl-list svg {
    width: 16px;
    height: 16px;
    color: var(--teal);
    flex-shrink: 0;
    margin-top: 3px;
  }

  .r-contact {
    font-size: 14px;
    color: var(--navy);
    margin-bottom: 20px;
  }

  .r-actions {
    display: flex;
    gap: 12px;
  }

  .region-visual {
    height: 100%;
    min-height: 280px;
    background: linear-gradient(135deg, var(--navy), var(--navy-ink));
    border-radius: var(--r-xl);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 32px 24px;
    color: #fff;
  }

  .visual-box {
    position: relative;
    z-index: 2;
  }

  .visual-icon {
    font-size: 44px;
    margin-bottom: 12px;
  }

  .visual-title {
    font-size: 20px;
    font-weight: 800;
    margin-bottom: 4px;
  }

  .visual-stat {
    font-size: 13.5px;
    color: var(--teal);
    font-weight: 700;
    margin-bottom: 14px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .visual-box p {
    font-size: 13.5px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
    max-width: 280px;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
    margin-top: 36px;
  }

  @media (max-width: 1024px) {
    .steps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .steps-grid {
      grid-template-columns: 1fr;
    }
  }

  .step-card {
    background: #fff;
    padding: 28px 20px;
    border-radius: var(--r-xl);
    border: 1px solid var(--line);
    position: relative;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .step-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--sh-md);
  }

  .step-number {
    font-family: var(--font-cond);
    font-size: 28px;
    font-weight: 900;
    color: var(--teal);
    margin-bottom: 12px;
    line-height: 1;
  }

  .step-card h3 {
    font-size: 16px;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 10px;
    line-height: 1.35;
  }

  .step-card p {
    font-size: 13.5px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .setup-cta {
    background: linear-gradient(135deg, var(--navy), var(--navy-ink));
    border-radius: var(--r-2xl);
    color: #fff;
    padding: 56px 40px;
    text-align: center;
    position: relative;
    overflow: hidden;
    box-shadow: var(--sh-lg);
  }

  .setup-cta-in {
    max-width: 720px;
    margin: 0 auto;
  }

  .setup-cta h2 {
    font-size: 28px;
    font-weight: 900;
    margin-bottom: 14px;
  }

  .setup-cta p {
    font-size: 16px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 28px;
  }

  @media (max-width: 900px) {
    .region-card, .region-card.reverse {
      grid-template-columns: 1fr;
      padding: 28px 20px;
    }
    .region-card.reverse .region-info {
      order: 1;
    }
    .region-card.reverse .region-visual {
      order: 2;
    }
  }
</style>
