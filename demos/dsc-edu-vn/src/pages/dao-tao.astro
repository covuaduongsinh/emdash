---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ConsultForm from '../components/ConsultForm.astro';

const levels = [
  {
    step: '1/6',
    piece: 'Tốt',
    tag: 'Nhập môn',
    icon: '/brand/pieces/wp.svg',
    title: 'Cấp độ 1 — Tốt (Vỡ lòng & Quy tắc cơ bản)',
    desc: 'Làm quen với bàn cờ 64 ô, cách di chuyển và ăn quân của 6 loại quân cờ. Hiểu rõ quy tắc chiếu, chiếu hết, phong cấp, nhập thành và bắt tốt qua đường.',
    outcomes: ['Nắm vững luật cờ vua quốc tế FIDE chuẩn', 'Biết cách ghi biên bản ván cờ học đường', 'Rèn luyện thói quen tập trung trong 45–60 phút'],
    bg: 'var(--navy)',
  },
  {
    step: '2/6',
    piece: 'Mã',
    tag: 'Cơ bản 1',
    icon: '/brand/pieces/wn.svg',
    title: 'Cấp độ 2 — Mã (Tư duy không gian & Đòn đôi)',
    desc: 'Khám phá sự biến hóa và linh hoạt của quân Mã, nhận diện đòn bắt đôi và chiếu mở. Nắm vững nguyên tắc an toàn vua và chiếm lĩnh trung tâm bàn cờ.',
    outcomes: ['Thành thạo đòn chiến thuật bắt đôi', 'Khai cuộc theo đúng 3 nguyên lý chuẩn', 'Tính toán trước 2–3 nước cờ logic'],
    bg: 'var(--navy-soft)',
  },
  {
    step: '3/6',
    piece: 'Tượng',
    tag: 'Cơ bản 2',
    icon: '/brand/pieces/wb.svg',
    title: 'Cấp độ 3 — Tượng (Kiểm soát đường chéo & Đòn giằng)',
    desc: 'Khai thác tối đa sức mạnh cặp Tượng trên các đường chéo mở. Làm chủ đòn giằng, đòn xiên và phối hợp hài hòa giữa Tượng – Mã trong trung cuộc.',
    outcomes: ['Sử dụng đòn giằng và mở đường chính xác', 'Chiến thuật phối hợp quân nhịp nhàng', 'Giải thành thạo bài tập thế cờ 2–3 nước'],
    bg: 'var(--navy-soft)',
  },
  {
    step: '4/6',
    piece: 'Xe',
    tag: 'Cơ bản 3',
    icon: '/brand/pieces/wr.svg',
    title: 'Cấp độ 4 — Xe (Cột mở & Chiến lược tàn cuộc)',
    desc: 'Nắm quyền kiểm soát các cột mở và hàng ngang số 7. Trang bị kỹ thuật cờ tàn căn bản với Xe và Tốt, nguyên lý hình học bàn cờ và quy tắc ô vuông.',
    outcomes: ['Khai thác sức mạnh Xe trên cột mở', 'Thành thạo kỹ thuật cờ tàn Xe cơ bản', 'Lập kế hoạch tấn công và phòng thủ trung cuộc'],
    bg: 'var(--navy-soft)',
  },
  {
    step: '5/6',
    piece: 'Hậu',
    tag: 'Nâng cao 1',
    icon: '/brand/pieces/wq.svg',
    title: 'Cấp độ 5 — Hậu (Phối hợp toàn năng)',
    desc: 'Phát huy sức mạnh áp đảo của quân Hậu trong phối hợp lực lượng. Nghiên cứu các hệ thống khai cuộc bài bản, chiến thuật công thành và phản công.',
    outcomes: ['Xây dựng kho biến thể khai cuộc ưa thích', 'Phân tích cấu trúc Tốt và điểm yếu', 'Nâng cao khả năng phân tích logic & trung tàn cuộc'],
    bg: 'var(--navy-soft)',
  },
  {
    step: '6/6',
    piece: 'Vua',
    tag: 'Nâng cao 2',
    icon: '/brand/pieces/wk.svg',
    title: 'Cấp độ 6 — Vua (Bản lĩnh tư duy & Phong cách thủ lĩnh)',
    desc: 'Tư duy chiến lược cao cấp, rèn luyện tâm lý điềm tĩnh và kiểm soát áp lực. Tính toán sâu 5–7 nước, làm chủ thời gian và ra quyết định chính xác.',
    outcomes: ['Nắm vững tư duy chiến lược trung tàn cuộc', 'Hình thành bản lĩnh kiên định và phong thái điềm đạm', 'Phát triển năng lực lãnh đạo và tư duy phản biện'],
    bg: 'var(--teal-soft)',
  },
];
---

<Layout title="Khung Giáo Trình Cờ Vua Học Đường Toàn Diện — covuahocduong.com">
  <PageHero
    title="Khung Giáo Trình Cờ Vua Học Đường"
    lead="Chương trình chuẩn hóa năng lực từ Mầm non đến Phổ thông trung học, được thiết kế khoa học giúp học sinh phát triển tư duy logic, tính kiên nhẫn và bản lĩnh học đường."
    crumbCurrent="Giáo trình học đường"
    badge="CHUẨN HỌC ĐƯỜNG TOÀN DIỆN"
    chips={['Chuẩn FIDE Quốc tế', 'Phương pháp sư phạm trực quan', 'Hệ thống bài tập FEN/PGN', 'Dành cho trường học toàn quốc']}
  />

  <!-- 1. Lộ trình 6 cấp -->
  <section class="sec alt reveal">
    <div class="wrap">
      <div class="shead">
        <div class="overline overline--teal">CHUẨN HÓA NĂNG LỰC</div>
        <h2>Hệ thống 6 Cấp Độ Đào Tạo (Tốt ➔ Vua)</h2>
        <p>Mỗi cấp độ đều có chuẩn đầu ra rõ ràng về kiến thức, kỹ thuật chiến thuật và kỹ năng tư duy học đường.</p>
      </div>

      <div class="level-grid">
        {levels.map((lvl) => (
          <div class="level-card">
            <div class="level-head">
              <div class="level-icon-box" style={`background: ${lvl.bg};`}>
                <img src={lvl.icon} alt={lvl.piece} class="level-icon" style={lvl.piece === 'Tốt' ? 'filter: brightness(0) invert(1);' : ''} />
              </div>
              <div>
                <span class="level-step">{lvl.step} · {lvl.tag}</span>
                <h3 class="level-title">{lvl.title}</h3>
              </div>
            </div>

            <p class="level-desc">{lvl.desc}</p>

            <div class="level-outcomes">
              <div class="outcome-label">Chuẩn đầu ra trọng tâm:</div>
              <ul>
                {lvl.outcomes.map((item) => (
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 2. Phân nhóm theo độ tuổi -->
  <section class="sec reveal">
    <div class="wrap">
      <div class="shead">
        <div class="overline">PHƯƠNG PHÁP THEO BẬC HỌC</div>
        <h2>Phương pháp giảng dạy phù hợp từng lứa tuổi</h2>
        <p>Tối ưu hóa khả năng tiếp thu và truyền cảm hứng say mê cờ vua cho học sinh theo từng giai đoạn phát triển</p>
      </div>

      <div class="age-grid">
        <div class="age-card" id="mam-non">
          <div class="age-head">
            <div class="age-icon-wrap">
              <img src="/brand/pieces/wn.svg" alt="Mầm non" />
            </div>
            <div>
              <span class="age-badge">4 – 6 TUỔI</span>
              <h3>Bậc Mầm Non — Cờ Vua Kể Chuyện</h3>
            </div>
          </div>
          <p>
            Trẻ mầm non tiếp thu thế giới qua hình tượng và cảm xúc. Phương pháp nhân cách hóa các quân cờ thành những nhân vật ngộ nghĩnh giúp trẻ yêu thích bàn cờ, ghi nhớ luật chơi tự nhiên, đồng thời rèn luyện tính tập trung và tư duy không gian từ sớm.
          </p>
        </div>

        <div class="age-card" id="tieu-hoc">
          <div class="age-head">
            <div class="age-icon-wrap">
              <img src="/brand/pieces/wb.svg" alt="Tiểu học" />
            </div>
            <div>
              <span class="age-badge">LỚP 1 – 5</span>
              <h3>Bậc Tiểu Học — Rèn Luyện Tư Duy Chiến Thuật</h3>
            </div>
          </div>
          <p>
            Giai đoạn vàng để hình thành tư duy logic và kỹ năng giải quyết vấn đề. Học sinh tiểu học được học cách giải các thế cờ thực chiến, rèn tính cẩn trọng "nghĩ trước khi đi", tinh thần thể thao trung thực và biết tôn trọng đối thủ.
          </p>
        </div>

        <div class="age-card" id="trung-hoc">
          <div class="age-head">
            <div class="age-icon-wrap">
              <img src="/brand/pieces/wq.svg" alt="Trung học" />
            </div>
            <div>
              <span class="age-badge">LỚP 6 – 12</span>
              <h3>Bậc THCS & THPT — Chiến Lược, Logic & Phản Biện</h3>
            </div>
          </div>
          <p>
            Tập trung phát triển tư duy phản biện, lập kế hoạch chiến lược và quản lý thời gian. Học sinh được trang bị phương pháp tư duy logic đa chiều, rèn luyện tính kỷ luật và sự kiềm chế cảm xúc trong mọi tình huống.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Mô hình triển khai học đường -->
  <section class="sec alt reveal">
    <div class="wrap">
      <div class="shead">
        <div class="overline overline--teal">MÔ HÌNH HỌC ĐƯỜNG</div>
        <h2>Các mô hình triển khai cờ vua trong trường học</h2>
        <p>Linh hoạt ứng dụng vào chương trình giáo dục thể chất, hoạt động trải nghiệm và câu lạc bộ ngoại khóa</p>
      </div>

      <div class="model-grid">
        <!-- Mô hình 1 -->
        <div class="model-card">
          <div class="model-badge">MÔ HÌNH 01</div>
          <h3>CLB Cờ Vua Ngoại Khóa Trường Học</h3>
          <p class="model-desc">Thành lập câu lạc bộ cờ vua sinh hoạt định kỳ sau giờ học, tạo sân chơi trí tuệ lành mạnh cho học sinh toàn trường.</p>
          <ul class="model-features">
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Sinh hoạt 1–2 buổi / tuần</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Cung cấp trọn bộ giáo án và tài liệu</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Sinh hoạt chuyên đề và giao lưu nội bộ</li>
          </ul>
        </div>

        <!-- Mô hình 2 -->
        <div class="model-card featured">
          <div class="model-ribbon">Phổ biến</div>
          <div class="model-badge">MÔ HÌNH 02</div>
          <h3>Tích Hợp Tiết Học Thể Chất & Kỹ Năng</h3>
          <p class="model-desc">Đưa cờ vua vào môn Giáo dục Thể chất hoặc chương trình kỹ năng sống theo định hướng phát triển phẩm chất học sinh.</p>
          <ul class="model-features">
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> 100% học sinh khối lớp được tiếp cận</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Hỗ trợ tập huấn phương pháp cho giáo viên</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Đánh giá sự phát triển tư duy định kỳ</li>
          </ul>
        </div>

        <!-- Mô hình 3 -->
        <div class="model-card">
          <div class="model-badge">MÔ HÌNH 03</div>
          <h3>Bồi Dưỡng Chuyên Sâu & Năng Khiếu Học Đường</h3>
          <p class="model-desc">Bồi dưỡng các học sinh có niềm say mê và năng khiếu vượt trội, phát triển chuyên sâu kho lý thuyết và thế cờ nghệ thuật.</p>
          <ul class="model-features">
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Kế hoạch bồi dưỡng chuyên đề nâng cao</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Phân tích chuyên sâu các ván cờ kinh điển</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Cố vấn chuyên môn bởi các Kiện tướng & Giảng viên</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Form nhận tài liệu & kết nối -->
  <section class="sec reveal" style="padding-top: 30px;">
    <div class="wrap">
      <ConsultForm id="ket-noi" />
    </div>
  </section>
</Layout>

<style>
  /* Levels */
  .level-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }

  .level-card {
    background: #fff;
    border-radius: var(--r-xl);
    padding: 32px;
    border: 1px solid var(--line);
    box-shadow: var(--sh-sm);
    transition: transform var(--dur);
  }

  .level-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--sh-md);
  }

  .level-head {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 18px;
  }

  .level-icon-box {
    width: 64px;
    height: 64px;
    border-radius: var(--r-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .level-icon {
    width: 38px;
    height: 38px;
  }

  .level-step {
    font-family: var(--font-cond);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--teal-deep);
    text-transform: uppercase;
  }

  .level-title {
    font-size: 19px;
    font-weight: 900;
    color: var(--navy);
    margin-top: 2px;
  }

  .level-desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  .level-outcomes {
    background: var(--bg);
    border-radius: var(--r-md);
    padding: 16px 20px;
    border: 1px solid var(--line-soft);
  }

  .outcome-label {
    font-size: 12.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--navy);
    margin-bottom: 8px;
  }

  .level-outcomes ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .level-outcomes li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13.5px;
    color: var(--text-secondary);
  }

  .level-outcomes svg {
    width: 14px;
    height: 14px;
    stroke: var(--teal-deep);
    flex-shrink: 0;
  }

  /* Age groups */
  .age-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .age-card {
    background: #fff;
    border-radius: var(--r-xl);
    padding: 32px;
    border: 1px solid var(--line);
    box-shadow: var(--sh-sm);
  }

  .age-head {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 18px;
  }

  .age-icon-wrap {
    width: 56px;
    height: 56px;
    border-radius: var(--r-lg);
    background: var(--navy-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .age-icon-wrap img {
    width: 32px;
    height: 32px;
  }

  .age-badge {
    font-family: var(--font-cond);
    font-size: 12px;
    font-weight: 700;
    color: var(--teal-deep);
    letter-spacing: 0.08em;
  }

  .age-head h3 {
    font-size: 18px;
    font-weight: 800;
    color: var(--navy);
    margin-top: 2px;
  }

  .age-card p {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  /* Models */
  .model-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .model-card {
    background: #fff;
    border-radius: var(--r-xl);
    padding: 36px 28px;
    border: 1px solid var(--line);
    box-shadow: var(--sh-sm);
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform var(--dur);
  }

  .model-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--sh-hover);
  }

  .model-card.featured {
    border-color: var(--teal);
    box-shadow: 0 12px 32px rgba(43, 57, 144, 0.12);
  }

  .model-ribbon {
    position: absolute;
    top: 16px;
    right: 16px;
    background: var(--coral);
    color: #fff;
    font-family: var(--font-cond);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: var(--r-pill);
  }

  .model-badge {
    font-family: var(--font-cond);
    font-size: 12px;
    font-weight: 700;
    color: var(--teal-deep);
    letter-spacing: 0.08em;
    margin-bottom: 8px;
  }

  .model-card h3 {
    font-size: 20px;
    font-weight: 900;
    color: var(--navy);
    margin-bottom: 12px;
  }

  .model-desc {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 24px;
    flex-grow: 1;
  }

  .model-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-top: 1px solid var(--line-soft);
    padding-top: 20px;
  }

  .model-features li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--text-secondary);
  }

  .model-features svg {
    width: 16px;
    height: 16px;
    stroke: var(--teal-deep);
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .level-grid, .age-grid, .model-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
