---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ConsultForm from '../components/ConsultForm.astro';

const specialists = [
  {
    name: 'Thầy Bùi Việt Anh',
    role: 'TRƯỞNG BAN CHUYÊN MÔN CỜ VUA HỌC ĐƯỜNG',
    title: 'ELO 1900 · Chủ nhiệm Đề án Chuẩn hóa Giáo trình Học đường',
    bio: 'Tốt nghiệp Đại học Bách Khoa Hà Nội, giàu kinh nghiệm quản lý và huấn luyện đội tuyển cờ vua trẻ. Thầy chủ trì nghiên cứu và xây dựng khung giáo trình cờ vua học đường 6 cấp độ, tích hợp phương pháp tư duy toán học và giải quyết vấn đề cho học sinh phổ thông.',
    icon: '/brand/pieces/wk.svg',
    strengths: ['Xây dựng khung giáo trình & giáo án sư phạm', 'Phương pháp tư duy logic & giải bài tập thế cờ', 'Tập huấn giáo viên Thể dục & Tổng phụ trách'],
  },
  {
    name: 'Thầy Bùi Đức Huy',
    role: 'PHỤ TRÁCH BỒI DƯỠNG NÂNG CAO & CHIẾN LƯỢC TRUNG TÀN CUỘC',
    title: 'ELO 2000 · Giảng viên Chuyên môn Cờ Vua Học Đường',
    bio: 'Đạt đẳng cấp ELO 2000, phụ trách nghiên cứu phương pháp giảng dạy chiến thuật trung tàn cuộc chuyên sâu và bồi dưỡng tư duy chiến lược logic cho học sinh phổ thông.',
    icon: '/brand/pieces/wn.svg',
    strengths: ['Chiến thuật tư duy & đòn phối hợp hiện đại', 'Kỹ thuật phân tích cờ thế chuyên sâu', 'Ứng dụng công cụ Engine phân tích thế cờ'],
  },
  {
    name: 'Cô Mai Thị Thu',
    role: 'CHUYÊN GIA SƯ PHẠM MẦM NON & CỜ VUA KHỞI ĐẦU',
    title: 'Cử nhân GD Mầm non ĐH Sư Phạm Hà Nội',
    bio: 'Tốt nghiệp Đại học Sư phạm Hà Nội chuyên ngành Giáo dục Mầm non. Cô là tác giả chuỗi bài giảng "Cờ vua Kể chuyện", giúp trẻ em lứa tuổi mầm non và lớp 1 tiếp cận cờ vua tự nhiên, rèn luyện sự tập trung và tính kỷ luật.',
    icon: '/brand/pieces/wb.svg',
    strengths: ['Phương pháp sư phạm cờ vua mầm non', 'Tâm lý học lứa tuổi & kích thích trí tò mò', 'Xây dựng thói quen kiên nhẫn & quan sát cho trẻ'],
  },
  {
    name: 'Thầy Dương Văn Duy',
    role: 'CHUYÊN GIA CÔNG NGHỆ & HỌC LIỆU TRỰC TUYẾN',
    title: 'ELO 2000 · Kỹ sư Phần mềm ĐH Bách Khoa Hà Nội',
    bio: 'Đạt đẳng cấp ELO 2000, phụ trách phát triển hệ thống học liệu trực tuyến, công cụ giải cờ thế FEN/PGN và nền tảng bài giảng số cho các trường học trên toàn quốc.',
    icon: '/brand/pieces/wq.svg',
    strengths: ['Ứng dụng công nghệ trong giảng dạy cờ vua', 'Nền tảng học liệu & bài giảng điện tử', 'Thiết kế bài tập tương tác & FEN/PGN Viewer'],
  },
  {
    name: 'Cô Đỗ Nhật Quyên',
    role: 'CHUYÊN GIA BỒI DƯỠNG NĂNG KHIẾU TIỂU HỌC',
    title: 'ELO 1800 · Cố vấn Chuyên môn Khối Tiểu học',
    bio: 'Đạt đẳng cấp ELO 1800, nhiều năm nghiên cứu các mô hình cờ vua học đường quốc tế. Phụ trách thẩm định giáo án giảng dạy cờ vua tích hợp trong môn Giáo dục Thể chất khối Tiểu học.',
    icon: '/brand/pieces/wr.svg',
    strengths: ['Chuẩn hóa quy tắc bàn cờ & biên bản FIDE', 'Bài tập phát hiện đòn chiến thuật theo chủ đề', 'Phương pháp tạo động lực cho học sinh tiểu học'],
  },
  {
    name: 'Thầy Phạm Quốc An',
    role: 'ĐIỀU PHỐI VIÊN MẠNG LƯỚI CLB TRƯỜNG HỌC',
    title: 'Chuyên viên Phát triển Phong trào Thể thao Học sinh',
    bio: 'Phụ trách kết nối, hỗ trợ trang thiết bị dụng cụ và hướng dẫn quy trình thành lập câu lạc bộ cờ vua cho các trường phổ thông trên khắp 63 tỉnh thành.',
    icon: '/brand/pieces/wp.svg',
    strengths: ['Quy trình thành lập & vận hành CLB trường học', 'Tổ chức ngày hội cờ vua học đường', 'Kết nối giao lưu liên trường & tài trợ học liệu'],
  },
];

const standards = [
  {
    title: 'Sư phạm nhân văn & Tôn trọng cá tính',
    desc: 'Không đặt nặng áp lực điểm số; lấy sự phát triển tư duy, tính kiên nhẫn và nhân cách của học sinh làm trọng tâm.',
  },
  {
    title: 'Chuẩn mực quốc tế FIDE & Sư phạm học đường',
    desc: 'Mọi tài liệu, quy tắc bàn cờ và giáo trình đều tuân thủ chặt chẽ quy chuẩn sư phạm của Bộ GD&ĐT và Liên đoàn Cờ Thế giới.',
  },
  {
    title: 'Tinh thần Fair Play & Tác phong văn minh',
    desc: 'Học sinh được giáo dục tinh thần bắt tay tôn trọng đối thủ trước và sau ván đấu, chấp nhận thất bại như một cơ hội để học hỏi và hoàn thiện.',
  },
];
---

<Layout title="Hội Đồng Cố Vấn & Ban Chuyên Môn Cờ Vua Học Đường Toàn Quốc">
  <PageHero
    title="Hội Đồng Cố Vấn & Ban Chuyên Môn"
    lead="Tập hợp các đại kiện tướng, kiện tướng quốc gia, chuyên gia sư phạm mầm non và giáo dục thể chất hàng đầu, chung tay kiến tạo nền tảng cờ vua học đường chuẩn mực cho học sinh Việt Nam."
    crumbCurrent="Ban chuyên môn"
    badge="HỘI ĐỒNG CHUYÊN GIA TOÀN QUỐC"
    chips={['Kiện tướng ELO 1800–2000', 'ĐH Sư Phạm & ĐH Bách Khoa', 'Bảo trợ 850+ trường học', 'Khung giáo trình chuẩn quốc gia']}
  />

  <!-- Stats Strip -->
  <section class="sec alt" style="padding: 40px 0; border-bottom: 1px solid var(--line);">
    <div class="wrap">
      <div class="stats-strip">
        <div class="stat-box">
          <div class="stat-val">100%</div>
          <div class="stat-lbl">Giáo trình thẩm định sư phạm</div>
        </div>
        <div class="stat-box">
          <div class="stat-val">63</div>
          <div class="stat-lbl">Tỉnh thành kết nối chuyên gia</div>
        </div>
        <div class="stat-box">
          <div class="stat-val">850+</div>
          <div class="stat-lbl">Trường học & CLB được bảo trợ</div>
        </div>
        <div class="stat-box">
          <div class="stat-val">2000</div>
          <div class="stat-lbl">Đẳng cấp ELO hội đồng chuyên môn</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Specialist Cards Grid -->
  <section class="sec reveal">
    <div class="wrap">
      <div class="shead">
        <div class="overline overline--teal">HỘI ĐỒNG CHUYÊN MÔN</div>
        <h2>Đội ngũ Chuyên gia & Cố vấn Cờ Vua Học Đường</h2>
        <p>Những người thầy tâm huyết kiến tạo chương trình, bồi dưỡng giáo viên và thắp lửa đam mê trí tuệ cho thế hệ trẻ</p>
      </div>

      <div class="specialists-grid">
        {specialists.map((c) => (
          <div class="c-card">
            <div class="c-top">
              <div class="c-avatar-box">
                <img src={c.icon} alt={c.name} class="c-icon" />
              </div>
              <div class="c-top-info">
                <span class="c-role">{c.role}</span>
                <h3 class="c-name">{c.name}</h3>
                <span class="c-title-badge">{c.title}</span>
              </div>
            </div>

            <p class="c-bio">{c.bio}</p>

            <div class="c-strengths">
              <div class="strength-heading">Nhiệm vụ & Chuyên môn phụ trách:</div>
              <ul>
                {c.strengths.map((s) => (
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    <span>{s}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Giá trị chuẩn mực sư phạm -->
  <section class="sec alt reveal">
    <div class="wrap">
      <div class="shead">
        <div class="overline overline--teal">NGUYÊN TẮC CỐT LÕI</div>
        <h2>Chuẩn Mực Sư Phạm & Tinh Thần Thể Thao Học Đường</h2>
        <p>Cờ vua học đường hướng đến giáo dục toàn diện — rèn luyện trí tuệ, định hình nhân cách và bản lĩnh sống</p>
      </div>

      <div class="standards-grid">
        {standards.map((s) => (
          <div class="standard-card">
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Form kết nối chuyên gia -->
  <section class="sec reveal">
    <div class="wrap">
      <ConsultForm id="tu-van" />
    </div>
  </section>
</Layout>

<style>
  .stats-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    text-align: center;
  }

  .stat-val {
    font-family: var(--font-cond);
    font-size: 40px;
    font-weight: 900;
    color: var(--navy);
    line-height: 1;
    margin-bottom: 6px;
  }

  .stat-lbl {
    font-size: 13.5px;
    color: var(--muted);
    font-weight: 500;
  }

  .specialists-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }

  .c-card {
    background: #fff;
    border-radius: var(--r-xl);
    padding: 32px;
    border: 1px solid var(--line);
    box-shadow: var(--sh-sm);
    display: flex;
    flex-direction: column;
    transition: transform var(--dur);
  }

  .c-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--sh-md);
  }

  .c-top {
    display: flex;
    gap: 20px;
    margin-bottom: 16px;
  }

  .c-avatar-box {
    width: 76px;
    height: 76px;
    border-radius: var(--r-lg);
    background: linear-gradient(135deg, var(--navy), var(--navy-ink));
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .c-icon {
    width: 44px;
    height: 44px;
  }

  .c-role {
    font-family: var(--font-cond);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--teal-deep);
  }

  .c-name {
    font-size: 21px;
    font-weight: 900;
    color: var(--navy);
    margin: 3px 0 4px;
  }

  .c-title-badge {
    display: inline-block;
    font-size: 13px;
    color: var(--text-secondary);
    font-weight: 500;
    line-height: 1.4;
  }

  .c-bio {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--muted);
    margin-bottom: 20px;
    flex-grow: 1;
  }

  .c-strengths {
    background: var(--bg);
    border-radius: var(--r-md);
    padding: 16px 20px;
  }

  .strength-heading {
    font-size: 13px;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 8px;
  }

  .c-strengths ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .c-strengths li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13.5px;
    color: var(--text-secondary);
  }

  .c-strengths svg {
    width: 15px;
    height: 15px;
    color: var(--teal);
    flex-shrink: 0;
  }

  .standards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 24px;
  }

  .standard-card {
    background: #fff;
    padding: 32px 28px;
    border-radius: var(--r-xl);
    border: 1px solid var(--line);
  }

  .standard-card h3 {
    font-size: 18px;
    font-weight: 800;
    color: var(--navy);
    margin-bottom: 12px;
  }

  .standard-card p {
    font-size: 14.5px;
    color: var(--text-secondary);
    line-height: 1.65;
    margin: 0;
  }

  @media (max-width: 900px) {
    .stats-strip {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
    .specialists-grid, .standards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
