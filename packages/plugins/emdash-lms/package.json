{
  "name": "emdash-lms",
  "version": "0.2.0",
  "private": true,
  "description": "EmDash LMS — Subscriptions & Memberships plugin for EmDash CMS",
  "author": "Tô Triều <hello@totrieu.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tohaitrieu/emdash-lms.git"
  },
  "homepage": "https://github.com/tohaitrieu/emdash-lms#readme",
  "bugs": {
    "url": "https://github.com/tohaitrieu/emdash-lms/issues"
  },
  "keywords": [
    "emdash",
    "cms",
    "lms",
    "learning-management",
    "membership",
    "subscriptions",
    "courses",
    "astro",
    "headless-cms",
    "education",
    "e-learning"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./astro": "./src/integration.ts",
    "./admin": "./src/admin.tsx",
    "./pages/*": "./src/pages/*",
    "./styles/*": "./src/styles/*",
    "./seed.json": "./seed/seed.json",
    "./seed/membership.json": "./seed/membership.json",
    "./seed/courses.json": "./seed/courses.json"
  },
  "files": [
    "src",
    "seed"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {},
  "optionalDependencies": {
    "stripe": "^17.0.0"
  },
  "devDependencies": {
    "@phosphor-icons/react": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "astro": "catalog:",
    "emdash": "workspace:*",
    "react": "^18 || ^19"
  }
}
