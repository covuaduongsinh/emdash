---
/**
 * /checkout/{id} - Checkout page
 * In Phase 2a: Temporarily shows maintenance notice. Full SePay VietQR checkout is implemented in Phase 2b.
 */
import { getEmDashCollection } from "emdash";
import Layout from "virtual:emdash-lms/layout";
import { basePath } from "virtual:emdash-lms/config";

const { id } = Astro.params;
if (!id) return Astro.redirect(`${basePath}/plans`);

const type = Astro.url.searchParams.get("type") === "course" ? "course" : "membership";

let itemName = "Thẻ Thư Viện / Khóa Học";
let price = 0;
let currency = "VND";

if (type === "course") {
  const { entries: courses } = await getEmDashCollection("courses", {
    where: { fieldFilters: { slug: id } },
    limit: 1,
  });
  const course = courses[0];
  if (course) {
    itemName = course.data.title;
    price = course.data.sale_price ?? course.data.price ?? 0;
    currency = course.data.currency ?? "VND";
  }
} else {
  const { entries: plans } = await getEmDashCollection("membership_plans", {
    where: { fieldFilters: { slug: id } },
    limit: 1,
  });
  const plan = plans[0];
  if (plan) {
    itemName = plan.data.name;
    price = plan.data.sale_price ?? plan.data.price ?? 0;
    currency = plan.data.currency ?? "VND";
  }
}

function formatPrice(p: number, curr: string): string {
  return new Intl.NumberFormat(curr === "VND" ? "vi-VN" : "en-US", {
    style: "currency",
    currency: curr,
    minimumFractionDigits: 0,
  }).format(p);
}
---

<Layout title={`Đăng ký học liệu - ${itemName}`} description="Cổng thanh toán & Kích hoạt Thẻ thư viện">
  <div class="lms-checkout">
    <nav class="lms-breadcrumb">
      <a href={type === "course" ? `${basePath}/courses` : `${basePath}/plans`}>
        &larr; {type === "course" ? "Quay lại Kho học liệu" : "Quay lại Thẻ Thư Viện"}
      </a>
    </nav>

    <h1>Đăng ký Thẻ Thư Viện & Học Liệu Cờ Vua</h1>

    <div class="lms-checkout-layout">
      <section class="lms-checkout-summary">
        <h2>Thông tin đăng ký</h2>
        <div class="lms-checkout-item">
          <div class="lms-item-details">
            <span class="lms-item-name">{itemName}</span>
          </div>
          <span class="lms-item-price">
            {formatPrice(price, currency)}
          </span>
        </div>
      </section>

      <section class="lms-checkout-form-section">
        <div class="lms-maintenance-card" style="padding: 2rem; border: 1px solid var(--kumo-brand, #2B3990); border-radius: 8px; background: rgba(43, 57, 144, 0.05); text-align: center;">
          <h3 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.75rem; color: #2B3990;">
            Hệ thống thanh toán tự động VietQR đang được nâng cấp
          </h3>
          <p style="color: #4B5563; margin-bottom: 1.5rem; line-height: 1.6;">
            Cổng thanh toán tự động SePay sẽ chính thức kích hoạt ở phiên bản tiếp theo. Quý phụ huynh và học viên có nhu cầu kích hoạt Thẻ thư viện hoặc ghi danh chuyên đề cờ vua xin vui lòng liên hệ trực tiếp Ban Huấn Luyện Cờ Vua Học Đường.
          </p>
          <div style="display: flex; justify-content: center; gap: 1rem;">
            <a href="https://covuahocduong.com" class="lms-btn lms-btn-primary">
              Liên hệ Ban Huấn Luyện
            </a>
            <a href={`${basePath}/plans`} class="lms-btn lms-btn-outline">
              Xem các gói Thẻ thư viện
            </a>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>
