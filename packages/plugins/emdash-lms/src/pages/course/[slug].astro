---
/**
 * /course/{slug} - Course detail page
 * Optimized query paths with requestCached and field-filtered collection queries (Max 3 queries).
 */
import { getEmDashCollection, getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Layout from "virtual:emdash-lms/layout";
import { basePath } from "virtual:emdash-lms/config";

const { slug } = Astro.params;
if (!slug) return Astro.redirect(`${basePath}/courses`);

// 1. Fetch single course by slug
const { entry: course } = await getEmDashEntry("courses", slug);
if (!course) return Astro.redirect(`${basePath}/courses`);

const courseId = course.id;

// 2. Fetch modules for this course
const { entries: modules } = await getEmDashCollection("modules", {
  where: { fieldFilters: { course_id: courseId } },
});

  // 3. Fetch lessons for this course
  const { entries: lessons } = await getEmDashCollection("lessons", {
    where: { fieldFilters: { course_id: courseId } },
  });

  const sortedModules = modules.toSorted(
    (a, b) => (Number(a.data.sort_order) || 0) - (Number(b.data.sort_order) || 0)
  );

  const moduleLessons = sortedModules.map((mod) => ({
    module: mod,
    lessons: lessons
      .filter((l) => l.data.module_id === mod.id)
      .toSorted((a, b) => (Number(a.data.sort_order) || 0) - (Number(b.data.sort_order) || 0)),
  }));

  const totalLessons = moduleLessons.reduce((sum, m) => sum + m.lessons.length, 0);
  const totalDuration = moduleLessons.reduce(
    (sum, m) => sum + m.lessons.reduce((s, l) => s + (Number(l.data.duration_minutes) || 0), 0),
    0
  );

function formatDuration(minutes: number): string {
  const hours = Math.floor(minutes / 60);
  const mins = minutes % 60;
  if (hours === 0) return `${mins} phút`;
  if (mins === 0) return `${hours} giờ`;
  return `${hours} giờ ${mins} phút`;
}

const difficultyLabels: Record<string, string> = {
  beginner: "Tốt — Nhập môn & Vỡ lòng",
  intermediate: "Mã & Tượng — Căn bản & Trung cấp",
  advanced: "Xe & Hậu — Nâng cao & Chiến lược",
};
---

<Layout title={`${course.data.title} — covuahocduong.com`} description={course.data.excerpt}>
  <article class="lms-course-detail">
    {course.data.featured_image && (
      <div class="lms-course-hero">
        <img src={course.data.featured_image} alt={course.data.title} />
      </div>
    )}

    <div class="lms-container lms-course-layout">
      <div class="lms-course-main">
        <nav class="lms-breadcrumb">
          <a href={`${basePath}/courses`}>&larr; Tất cả chuyên đề bài giảng</a>
        </nav>

        <header class="lms-course-header">
          {course.data.difficulty && (
            <span class="lms-difficulty-badge">
              {difficultyLabels[course.data.difficulty] || course.data.difficulty}
            </span>
          )}
          <h1>{course.data.title}</h1>
          {course.data.excerpt && (
            <p class="lms-course-excerpt">{course.data.excerpt}</p>
          )}
          <div class="lms-course-stats">
            {totalLessons > 0 && (
              <span class="lms-stat">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                </svg>
                {totalLessons} bài học
              </span>
            )}
            {totalDuration > 0 && (
              <span class="lms-stat">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                </svg>
                {formatDuration(totalDuration)}
              </span>
            )}
            {sortedModules.length > 0 && (
              <span class="lms-stat">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                  <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
                </svg>
                {sortedModules.length} chương học
              </span>
            )}
          </div>
        </header>

        {course.data.content && (
          <div class="lms-course-content">
            <PortableText value={course.data.content} />
          </div>
        )}

        <!-- Curriculum -->
        <section class="lms-curriculum">
          <h2>Chương trình bài học</h2>
          {moduleLessons.length === 0 ? (
            <p class="lms-empty">Nội dung các bài học đang được cập nhật.</p>
          ) : (
            <div class="lms-modules">
              {moduleLessons.map(({ module: mod, lessons: modLessons }, i) => (
                <details class="lms-module" open={i === 0}>
                  <summary class="lms-module-header">
                    <div class="lms-module-title">
                      <span class="lms-module-index">Chương {i + 1}</span>
                      <h3>{mod.data.title}</h3>
                    </div>
                    <span class="lms-module-meta">{modLessons.length} bài</span>
                  </summary>
                  {mod.data.description && (
                    <p class="lms-module-desc">{mod.data.description}</p>
                  )}
                  <ul class="lms-lessons">
                    {modLessons.map((lesson) => (
                      <li class="lms-lesson-item">
                        <a href={`${basePath}/lesson/${lesson.data.slug || lesson.id}`} class="lms-lesson-link">
                          <span class="lms-lesson-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <polygon points="5 3 19 12 5 21 5 3"/>
                            </svg>
                          </span>
                          <span class="lms-lesson-title">{lesson.data.title}</span>
                          <span class="lms-lesson-badges">
                            {lesson.data.is_preview && (
                              <span class="lms-badge-preview">Học thử</span>
                            )}
                            {lesson.data.duration_minutes && (
                              <span class="lms-lesson-time">{lesson.data.duration_minutes}p</span>
                            )}
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ))}
            </div>
          )}
        </section>
      </div>

      <!-- Sidebar Card -->
      <aside class="lms-course-sidebar">
        <div class="lms-enroll-card">
          <div class="lms-card-body">
            {course.data.access_level === "free" ? (
              <>
                <p class="lms-card-badge">Chuyên đề mở</p>
                <div class="lms-card-price">Miễn phí 100%</div>
                <p class="lms-card-desc">Dành cho mọi học viên yêu thích cờ vua.</p>
                {moduleLessons[0]?.lessons[0] && (
                  <a
                    href={`${basePath}/lesson/${moduleLessons[0].lessons[0].data.slug || moduleLessons[0].lessons[0].id}`}
                    class="lms-btn lms-btn-primary lms-btn-block"
                  >
                    Bắt đầu học ngay
                  </a>
                )}
              </>
            ) : (
              <>
                <p class="lms-card-badge">Chuyên đề Thẻ thư viện</p>
                <div class="lms-card-price">Thẻ Thư Viện</div>
                <p class="lms-card-desc">
                  Mở khóa toàn bộ bài giảng, chuyên đề và kho câu đố cờ vua.
                </p>
                <a href={`${basePath}/plans`} class="lms-btn lms-btn-primary lms-btn-block">
                  Đăng ký Thẻ thư viện
                </a>
              </>
            )}
          </div>
        </div>
      </aside>
    </div>
  </article>
</Layout>
