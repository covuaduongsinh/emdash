---
/**
 * /plans - Thẻ Thư Viện Học Đường (Membership Plans)
 * Định hướng học đường, không dùng huy hiệu thương mại giảm giá
 */
import { getEmDashCollection } from "emdash";
import Layout from "virtual:emdash-lms/layout";
import { basePath } from "virtual:emdash-lms/config";

const { entries: plans } = await getEmDashCollection("membership_plans");
const publishedPlans = plans
  .filter((p) => p.data.status === "published" || p.data.status === "publish")
  .toSorted((a, b) => (a.data.sort_order ?? 0) - (b.data.sort_order ?? 0));

function formatPrice(price: number, currency: string = "VND"): string {
  return new Intl.NumberFormat(currency === "VND" ? "vi-VN" : "en-US", {
    style: "currency",
    currency,
    minimumFractionDigits: 0,
  }).format(price);
}

function getPeriodLabel(period?: string): string {
  switch (period) {
    case "monthly":
      return "tháng";
    case "quarterly":
      return "quý (3 tháng)";
    case "yearly":
      return "năm (12 tháng)";
    case "lifetime":
      return "trọn đời";
    default:
      return period ? `${period}` : "";
  }
}
---

<Layout title="Thẻ Thư Viện Học Đường — covuahocduong.com" description="Đăng ký quyền truy cập kho học liệu cờ vua học đường chuẩn hóa">
  <div class="lms-pricing">
    <header class="lms-page-header">
      <h1>Thẻ Thư Viện Học Liệu Cờ Vua</h1>
      <p>Đồng hành cùng học sinh, phụ huynh và nhà trường với nguồn học liệu cờ vua chuẩn hóa toàn diện</p>
    </header>

    {publishedPlans.length === 0 ? (
      <p class="lms-empty">Chưa có thông tin thẻ thư viện.</p>
    ) : (
      <div class="lms-plans-grid">
        {publishedPlans.map((plan) => {
          const currency = plan.data.currency ?? "VND";
          const finalPrice = plan.data.sale_price ?? plan.data.price ?? 0;
          const periodLabel = getPeriodLabel(plan.data.billing_period);

          return (
            <div class="lms-plan-card">
              <h3>{plan.data.name}</h3>

              <div class="lms-plan-price">
                <span>{formatPrice(finalPrice, currency)}</span>
                {periodLabel && (
                  <span class="lms-billing-period">
                    /{periodLabel}
                  </span>
                )}
              </div>

              {plan.data.description && <p class="lms-plan-description">{plan.data.description}</p>}

              {plan.data.features && plan.data.features.length > 0 && (
                <ul class="lms-plan-features">
                  {plan.data.features.map((feature: string) => (
                    <li>{feature}</li>
                  ))}
                </ul>
              )}

              <a href={`${basePath}/checkout/${plan.data.slug || plan.id}`} class="lms-plan-cta">
                Đăng ký Thẻ Thư Viện
              </a>
            </div>
          );
        })}
      </div>
    )}
  </div>
</Layout>
