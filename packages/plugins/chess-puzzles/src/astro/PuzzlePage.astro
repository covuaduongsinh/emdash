---
import "@duongsinh/chess-kit/theme.css";
import PuzzleIsland from "./PuzzleIsland.jsx";

interface Props {
	puzzle: {
		id: string;
		title: string;
		puzzle: {
			fen: string;
			moves?: string[];
			solution?: string[];
			orientation?: "white" | "black";
		};
		prompt?: string;
		level?: string;
		themes?: string;
		rating?: number;
		hint?: string;
		explanation?: string;
		source?: string;
	};
}

const { puzzle } = Astro.props;
const puzzleData = puzzle.puzzle || { fen: "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1", moves: [] };
const fen = puzzleData.fen;
const solution = puzzleData.solution || puzzleData.moves || [];
const orientation = puzzleData.orientation || (fen.split(" ")[1] === "b" ? "black" : "white");
---

<div class="chess-puzzle-page mx-auto max-w-4xl p-4 sm:p-6 lg:p-8" data-lms-requirement={`puzzle:${puzzle.id}`}>
	<div class="mb-6 flex flex-wrap items-center justify-between gap-4 border-b border-gray-200 pb-4 dark:border-gray-800">
		<div>
			<a href="/cau-do" class="text-sm font-medium text-blue-600 hover:underline dark:text-blue-400">
				&larr; Tất cả câu đố
			</a>
			<h1 class="mt-1 text-2xl font-extrabold tracking-tight text-gray-900 sm:text-3xl dark:text-gray-100">
				{puzzle.title}
			</h1>
		</div>

		<div class="flex items-center gap-2">
			{puzzle.level && (
				<span class="rounded bg-indigo-100 px-2.5 py-1 text-xs font-semibold text-indigo-800 uppercase dark:bg-indigo-900/50 dark:text-indigo-300">
					{puzzle.level}
				</span>
			)}
			{puzzle.rating && (
				<span class="rounded bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-300">
					Elo {puzzle.rating}
				</span>
			)}
		</div>
	</div>

	<div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
		<div class="flex justify-center lg:col-span-8">
			<PuzzleIsland
				client:visible
				puzzleId={puzzle.id}
				fen={fen}
				solution={solution}
				prompt={puzzle.prompt}
				hint={puzzle.hint}
				level={puzzle.level}
				orientation={orientation}
				explanation={puzzle.explanation}
			/>
		</div>

		<div class="space-y-4 lg:col-span-4">
			<div class="rounded-xl border border-gray-200 bg-gray-50 p-4 dark:border-gray-800 dark:bg-gray-900/50">
				<h3 class="text-sm font-bold text-gray-900 dark:text-gray-100">Thông Tin Câu Đố</h3>
				<dl class="mt-3 space-y-2 text-xs">
					{puzzle.prompt && (
						<div>
							<dt class="font-medium text-gray-500 dark:text-gray-400">Yêu cầu:</dt>
							<dd class="mt-0.5 text-gray-900 dark:text-gray-200">{puzzle.prompt}</dd>
						</div>
					)}
					{puzzle.themes && (
						<div>
							<dt class="font-medium text-gray-500 dark:text-gray-400">Chủ đề:</dt>
							<dd class="mt-0.5 text-gray-900 dark:text-gray-200">{puzzle.themes}</dd>
						</div>
					)}
					{puzzle.source && (
						<div>
							<dt class="font-medium text-gray-500 dark:text-gray-400">Nguồn:</dt>
							<dd class="mt-0.5 text-gray-900 dark:text-gray-200">{puzzle.source}</dd>
						</div>
					)}
				</dl>
			</div>
		</div>
	</div>
</div>
