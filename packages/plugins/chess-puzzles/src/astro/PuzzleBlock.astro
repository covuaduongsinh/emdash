---
import "@duongsinh/chess-kit/theme.css";
import PuzzleIsland from "./PuzzleIsland.jsx";

interface Props {
	node?: {
		puzzle?: string;
		puzzleId?: string;
		fen?: string;
		solution?: string[] | string;
		prompt?: string;
		hint?: string;
		level?: string;
		title?: string;
		orientation?: "white" | "black" | "auto";
		explanation?: string;
		[key: string]: unknown;
	};
	puzzle?: string;
	puzzleId?: string;
	fen?: string;
	solution?: string[] | string;
	prompt?: string;
	hint?: string;
	level?: string;
	title?: string;
	orientation?: "white" | "black" | "auto";
	explanation?: string;
}

const props = Astro.props;
const data = props.node || props;

const puzzleId = data.puzzle || data.puzzleId || "custom";
const fen = data.fen || "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";
const solution = data.solution || [];
const prompt = data.prompt;
const hint = data.hint;
const level = data.level;
const title = data.title;
const orientation = data.orientation || (fen.split(" ")[1] === "b" ? "black" : "white");
const explanation = typeof data.explanation === "string" ? data.explanation : undefined;
---

<div class="chess-puzzle-block my-6" data-lms-requirement={`puzzle:${puzzleId}`}>
	{title && (
		<div class="mb-3 flex items-center justify-between">
			<h4 class="text-base font-bold text-gray-900 dark:text-gray-100">{title}</h4>
			{level && (
				<span class="rounded bg-blue-100 px-2 py-0.5 text-xs font-semibold text-blue-800 uppercase">
					{level}
				</span>
			)}
		</div>
	)}

	<PuzzleIsland
		client:visible
		puzzleId={puzzleId}
		fen={fen}
		solution={solution}
		prompt={prompt}
		hint={hint}
		level={level}
		orientation={orientation}
		explanation={explanation}
	/>
</div>

<style>
	.chess-puzzle-block {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 100%;
	}
</style>
